def adj39 (a b : Fin 39) : Bool := adjB 39 chords39 a.val b.val
def G39 : SimpleGraph (Fin 39) := SimpleGraph.fromRel (fun u v => adjB 39 chords39 u.val v.val = true)
theorem adj39_irrefl : ∀ a : Fin 39, adj39 a a = false := by decide
theorem adj39_spec (a b : Fin 39) (h : adj39 a b = true) : G39.Adj a b := by
  unfold G39
  rw [SimpleGraph.fromRel_adj]
  refine ⟨fun hab => ?_, Or.inl h⟩
  subst hab
  rw [adj39_irrefl] at h
  exact Bool.false_ne_true h
