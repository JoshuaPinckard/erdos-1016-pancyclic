def adjB (n : Nat) (cs : List (Nat × Nat)) (u v : Nat) : Bool :=
  (v == (u+1) % n) || (u == (v+1) % n) || cs.contains (u,v) || cs.contains (v,u)
def G38 : SimpleGraph (Fin 38) :=
  SimpleGraph.fromRel (fun u v => adjB 38 chords38 u.val v.val = true)
