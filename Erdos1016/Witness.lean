def isCycleB (n : Nat) (cs : List (Nat × Nat)) (l : List Nat) : Bool :=
  l.length >= 3 && (l.all (fun v => v < n)) && (decide (l.Nodup)) &&
  (l.zip l.tail).all (fun p => adjB n cs p.1 p.2) &&
  match l.head?, l.getLast? with
  | some a, some b => adjB n cs b a
  | _, _ => false
theorem lens38 : cycles38.map List.length = List.range' 3 36 := by decide
theorem lens41 : cycles41.map List.length = List.range' 3 39 := by decide
theorem allCycles38 : cycles38.all (isCycleB 38 chords38) = true := by decide
theorem allCycles41 : cycles41.all (isCycleB 41 chords41) = true := by decide

def suffices38 (cs : List (Nat × Nat)) : Bool :=
  cs.length == 5 && (List.range' 3 36).all (fun ℓ =>
    cycles38.any (fun l => l.length == ℓ && isCycleB 38 cs l))

def suffices41 (cs : List (Nat × Nat)) : Bool :=
  cs.length == 6 && (List.range' 3 39).all (fun ℓ =>
    cycles41.any (fun l => l.length == ℓ && isCycleB 41 cs l))

theorem h38_le : suffices38 chords38 = true := by decide
theorem h41_le : suffices41 chords41 = true := by decide
