def csF61 : Finset (Sym2 (Fin 61)) := {s(0,2), s(0,54), s(1,13), s(3,55), s(4,31), s(53,56)}
set_option maxHeartbeats 0 in
theorem csF61_card : csF61.card = 6 := by decide

-- `decide` over all pairs of `Fin 61`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF61_iff (a b : Fin 61) :
    (adjF61 a b = true ∨ adjF61 b a = true) ↔
      ((b.val = (a.val + 1) % 61 ∨ a.val = (b.val + 1) % 61) ∨ s(a, b) ∈ csF61) := by
  revert a b
  decide

theorem GF61_eq : baseCycle 61 ⊔ SimpleGraph.fromEdgeSet (↑csF61 : Set (Sym2 (Fin 61))) = GF61 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF61, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF61_iff a b
  unfold adjF61 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF61_disjoint : ∀ e ∈ csF61, e ∉ (baseCycle 61).edgeSet := by
  intro e he
  simp only [csF61, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(61) ≤ 6`, by the family member at n = 61. -/
theorem pancyclicWithChords_F61 : PancyclicWithChords 61 6 :=
  ⟨csF61, csF61_card, csF61_disjoint, by rw [GF61_eq]; exact isPancyclic_GF61⟩

