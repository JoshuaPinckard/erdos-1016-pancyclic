  cyclesF65.map (List.map (fun v : ℕ => (⟨v % 65, Nat.mod_lt v (by decide)⟩ : Fin 65)))

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem candidatesF65 : (List.range' 3 (65 - 2)).all (fun ℓ => cyclesF65F.any (fun l =>
    (l.length == ℓ) && decide l.Nodup && chainB adjF65 l && closesB adjF65 l)) = true := by decide

theorem isPancyclic_GF65 : IsPancyclic GF65 :=
  isPancyclic_of_candidates GF65 adjF65 adjF65_spec cyclesF65F candidatesF65

def csF65 : Finset (Sym2 (Fin 65)) := {s(0,2), s(0,58), s(1,13), s(3,59), s(4,31), s(57,60)}
set_option maxHeartbeats 0 in
theorem csF65_card : csF65.card = 6 := by decide

-- `decide` over all pairs of `Fin 65`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF65_iff (a b : Fin 65) :
    (adjF65 a b = true ∨ adjF65 b a = true) ↔
      ((b.val = (a.val + 1) % 65 ∨ a.val = (b.val + 1) % 65) ∨ s(a, b) ∈ csF65) := by
  revert a b
  decide

theorem GF65_eq : baseCycle 65 ⊔ SimpleGraph.fromEdgeSet (↑csF65 : Set (Sym2 (Fin 65))) = GF65 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF65, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF65_iff a b
  unfold adjF65 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF65_disjoint : ∀ e ∈ csF65, e ∉ (baseCycle 65).edgeSet := by
  intro e he
  simp only [csF65, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(65) ≤ 6`, by the family member at n = 65. -/
theorem pancyclicWithChords_F65 : PancyclicWithChords 65 6 :=
  ⟨csF65, csF65_card, csF65_disjoint, by rw [GF65_eq]; exact isPancyclic_GF65⟩

