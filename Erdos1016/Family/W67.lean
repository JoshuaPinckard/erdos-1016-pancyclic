theorem isPancyclic_GF67 : IsPancyclic GF67 :=
  isPancyclic_of_candidates GF67 adjF67 adjF67_spec cyclesF67F candidatesF67

def csF67 : Finset (Sym2 (Fin 67)) := {s(0,2), s(0,60), s(1,13), s(3,61), s(4,31), s(59,62)}
set_option maxHeartbeats 0 in
theorem csF67_card : csF67.card = 6 := by decide

-- `decide` over all pairs of `Fin 67`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF67_iff (a b : Fin 67) :
    (adjF67 a b = true ∨ adjF67 b a = true) ↔
      ((b.val = (a.val + 1) % 67 ∨ a.val = (b.val + 1) % 67) ∨ s(a, b) ∈ csF67) := by
  revert a b
  decide

theorem GF67_eq : baseCycle 67 ⊔ SimpleGraph.fromEdgeSet (↑csF67 : Set (Sym2 (Fin 67))) = GF67 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF67, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF67_iff a b
  unfold adjF67 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF67_disjoint : ∀ e ∈ csF67, e ∉ (baseCycle 67).edgeSet := by
  intro e he
  simp only [csF67, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

