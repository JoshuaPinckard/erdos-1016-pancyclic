def adjF50 (a b : Fin 50) : Bool := adjB 50 chordsF50 a.val b.val
def GF50 : SimpleGraph (Fin 50) :=
  SimpleGraph.fromRel (fun u v => adjB 50 chordsF50 u.val v.val = true)
theorem adjF50_irrefl : ∀ a : Fin 50, adjF50 a a = false := by decide
theorem adjF50_spec (a b : Fin 50) (h : adjF50 a b = true) : GF50.Adj a b := by
  unfold GF50
  rw [SimpleGraph.fromRel_adj]
  refine ⟨fun hab => ?_, Or.inl h⟩
  subst hab
  rw [adjF50_irrefl] at h
  exact Bool.false_ne_true h

