theorem candidatesF50 : (List.range' 3 (50 - 2)).all (fun ℓ => cyclesF50F.any (fun l =>
    (l.length == ℓ) && decide l.Nodup && chainB adjF50 l && closesB adjF50 l)) = true := by decide

theorem isPancyclic_GF50 : IsPancyclic GF50 :=
  isPancyclic_of_candidates GF50 adjF50 adjF50_spec cyclesF50F candidatesF50

def csF50 : Finset (Sym2 (Fin 50)) := {s(0,2), s(0,43), s(1,13), s(3,44), s(4,31), s(42,45)}
set_option maxHeartbeats 0 in
theorem csF50_card : csF50.card = 6 := by decide

-- `decide` over all pairs of `Fin 50`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF50_iff (a b : Fin 50) :
    (adjF50 a b = true ∨ adjF50 b a = true) ↔
      ((b.val = (a.val + 1) % 50 ∨ a.val = (b.val + 1) % 50) ∨ s(a, b) ∈ csF50) := by
  revert a b
  decide

theorem GF50_eq : baseCycle 50 ⊔ SimpleGraph.fromEdgeSet (↑csF50 : Set (Sym2 (Fin 50))) = GF50 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF50, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF50_iff a b
  unfold adjF50 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF50_disjoint : ∀ e ∈ csF50, e ∉ (baseCycle 50).edgeSet := by
  intro e he
  simp only [csF50, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(50) ≤ 6`, by the family member at n = 50. -/
theorem pancyclicWithChords_F50 : PancyclicWithChords 50 6 :=
  ⟨csF50, csF50_card, csF50_disjoint, by rw [GF50_eq]; exact isPancyclic_GF50⟩

