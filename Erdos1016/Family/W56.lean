theorem adjF56_iff (a b : Fin 56) :
    (adjF56 a b = true ∨ adjF56 b a = true) ↔
      ((b.val = (a.val + 1) % 56 ∨ a.val = (b.val + 1) % 56) ∨ s(a, b) ∈ csF56) := by
  revert a b
  decide

theorem GF56_eq : baseCycle 56 ⊔ SimpleGraph.fromEdgeSet (↑csF56 : Set (Sym2 (Fin 56))) = GF56 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF56, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF56_iff a b
  unfold adjF56 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF56_disjoint : ∀ e ∈ csF56, e ∉ (baseCycle 56).edgeSet := by
  intro e he
  simp only [csF56, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

