theorem candidatesF52 : (List.range' 3 (52 - 2)).all (fun ℓ => cyclesF52F.any (fun l =>
    (l.length == ℓ) && decide l.Nodup && chainB adjF52 l && closesB adjF52 l)) = true := by decide

theorem isPancyclic_GF52 : IsPancyclic GF52 :=
