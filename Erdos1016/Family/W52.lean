theorem csF52_card : csF52.card = 6 := by decide

-- `decide` over all pairs of `Fin 52`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF52_iff (a b : Fin 52) :
    (adjF52 a b = true ∨ adjF52 b a = true) ↔
      ((b.val = (a.val + 1) % 52 ∨ a.val = (b.val + 1) % 52) ∨ s(a, b) ∈ csF52) := by
  revert a b
  decide

theorem GF52_eq : baseCycle 52 ⊔ SimpleGraph.fromEdgeSet (↑csF52 : Set (Sym2 (Fin 52))) = GF52 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF52, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF52_iff a b
  unfold adjF52 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF52_disjoint : ∀ e ∈ csF52, e ∉ (baseCycle 52).edgeSet := by
  intro e he
  simp only [csF52, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(52) ≤ 6`, by the family member at n = 52. -/
theorem pancyclicWithChords_F52 : PancyclicWithChords 52 6 :=
  ⟨csF52, csF52_card, csF52_disjoint, by rw [GF52_eq]; exact isPancyclic_GF52⟩

