def cyclesF64F : List (List (Fin 64)) :=
  cyclesF64.map (List.map (fun v : ℕ => (⟨v % 64, Nat.mod_lt v (by decide)⟩ : Fin 64)))

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem candidatesF64 : (List.range' 3 (64 - 2)).all (fun ℓ => cyclesF64F.any (fun l =>
    (l.length == ℓ) && decide l.Nodup && chainB adjF64 l && closesB adjF64 l)) = true := by decide

theorem isPancyclic_GF64 : IsPancyclic GF64 :=
  isPancyclic_of_candidates GF64 adjF64 adjF64_spec cyclesF64F candidatesF64

def csF64 : Finset (Sym2 (Fin 64)) := {s(0,2), s(0,57), s(1,13), s(3,58), s(4,31), s(56,59)}
set_option maxHeartbeats 0 in
theorem csF64_card : csF64.card = 6 := by decide

-- `decide` over all pairs of `Fin 64`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF64_iff (a b : Fin 64) :
    (adjF64 a b = true ∨ adjF64 b a = true) ↔
      ((b.val = (a.val + 1) % 64 ∨ a.val = (b.val + 1) % 64) ∨ s(a, b) ∈ csF64) := by
  revert a b
  decide

theorem GF64_eq : baseCycle 64 ⊔ SimpleGraph.fromEdgeSet (↑csF64 : Set (Sym2 (Fin 64))) = GF64 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF64, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF64_iff a b
  unfold adjF64 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF64_disjoint : ∀ e ∈ csF64, e ∉ (baseCycle 64).edgeSet := by
  intro e he
  simp only [csF64, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(64) ≤ 6`, by the family member at n = 64. -/
theorem pancyclicWithChords_F64 : PancyclicWithChords 64 6 :=
  ⟨csF64, csF64_card, csF64_disjoint, by rw [GF64_eq]; exact isPancyclic_GF64⟩

