theorem adjF59_iff (a b : Fin 59) :
    (adjF59 a b = true ∨ adjF59 b a = true) ↔
      ((b.val = (a.val + 1) % 59 ∨ a.val = (b.val + 1) % 59) ∨ s(a, b) ∈ csF59) := by
  revert a b
  decide

theorem GF59_eq : baseCycle 59 ⊔ SimpleGraph.fromEdgeSet (↑csF59 : Set (Sym2 (Fin 59))) = GF59 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF59, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF59_iff a b
  unfold adjF59 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF59_disjoint : ∀ e ∈ csF59, e ∉ (baseCycle 59).edgeSet := by
  intro e he
  simp only [csF59, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

