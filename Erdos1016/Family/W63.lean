theorem csF63_card : csF63.card = 6 := by decide

-- `decide` over all pairs of `Fin 63`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF63_iff (a b : Fin 63) :
    (adjF63 a b = true ∨ adjF63 b a = true) ↔
      ((b.val = (a.val + 1) % 63 ∨ a.val = (b.val + 1) % 63) ∨ s(a, b) ∈ csF63) := by
  revert a b
  decide

theorem GF63_eq : baseCycle 63 ⊔ SimpleGraph.fromEdgeSet (↑csF63 : Set (Sym2 (Fin 63))) = GF63 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF63, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF63_iff a b
  unfold adjF63 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF63_disjoint : ∀ e ∈ csF63, e ∉ (baseCycle 63).edgeSet := by
  intro e he
  simp only [csF63, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

