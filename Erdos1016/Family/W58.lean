set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF58_iff (a b : Fin 58) :
    (adjF58 a b = true ∨ adjF58 b a = true) ↔
      ((b.val = (a.val + 1) % 58 ∨ a.val = (b.val + 1) % 58) ∨ s(a, b) ∈ csF58) := by
  revert a b
  decide

theorem GF58_eq : baseCycle 58 ⊔ SimpleGraph.fromEdgeSet (↑csF58 : Set (Sym2 (Fin 58))) = GF58 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF58, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF58_iff a b
  unfold adjF58 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF58_disjoint : ∀ e ∈ csF58, e ∉ (baseCycle 58).edgeSet := by
  intro e he
  simp only [csF58, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

