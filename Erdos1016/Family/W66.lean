def cyclesF66F : List (List (Fin 66)) :=
  cyclesF66.map (List.map (fun v : ℕ => (⟨v % 66, Nat.mod_lt v (by decide)⟩ : Fin 66)))

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem candidatesF66 : (List.range' 3 (66 - 2)).all (fun ℓ => cyclesF66F.any (fun l =>
    (l.length == ℓ) && decide l.Nodup && chainB adjF66 l && closesB adjF66 l)) = true := by decide

theorem isPancyclic_GF66 : IsPancyclic GF66 :=
  isPancyclic_of_candidates GF66 adjF66 adjF66_spec cyclesF66F candidatesF66

def csF66 : Finset (Sym2 (Fin 66)) := {s(0,2), s(0,59), s(1,13), s(3,60), s(4,31), s(58,61)}
set_option maxHeartbeats 0 in
theorem csF66_card : csF66.card = 6 := by decide

-- `decide` over all pairs of `Fin 66`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF66_iff (a b : Fin 66) :
    (adjF66 a b = true ∨ adjF66 b a = true) ↔
      ((b.val = (a.val + 1) % 66 ∨ a.val = (b.val + 1) % 66) ∨ s(a, b) ∈ csF66) := by
  revert a b
  decide

theorem GF66_eq : baseCycle 66 ⊔ SimpleGraph.fromEdgeSet (↑csF66 : Set (Sym2 (Fin 66))) = GF66 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF66, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF66_iff a b
  unfold adjF66 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF66_disjoint : ∀ e ∈ csF66, e ∉ (baseCycle 66).edgeSet := by
  intro e he
  simp only [csF66, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(66) ≤ 6`, by the family member at n = 66. -/
theorem pancyclicWithChords_F66 : PancyclicWithChords 66 6 :=
  ⟨csF66, csF66_card, csF66_disjoint, by rw [GF66_eq]; exact isPancyclic_GF66⟩

