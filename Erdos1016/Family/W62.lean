theorem csF62_card : csF62.card = 6 := by decide

-- `decide` over all pairs of `Fin 62`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF62_iff (a b : Fin 62) :
    (adjF62 a b = true ∨ adjF62 b a = true) ↔
      ((b.val = (a.val + 1) % 62 ∨ a.val = (b.val + 1) % 62) ∨ s(a, b) ∈ csF62) := by
  revert a b
  decide

theorem GF62_eq : baseCycle 62 ⊔ SimpleGraph.fromEdgeSet (↑csF62 : Set (Sym2 (Fin 62))) = GF62 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF62, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF62_iff a b
  unfold adjF62 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF62_disjoint : ∀ e ∈ csF62, e ∉ (baseCycle 62).edgeSet := by
  intro e he
  simp only [csF62, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(62) ≤ 6`, by the family member at n = 62. -/
theorem pancyclicWithChords_F62 : PancyclicWithChords 62 6 :=
  ⟨csF62, csF62_card, csF62_disjoint, by rw [GF62_eq]; exact isPancyclic_GF62⟩

