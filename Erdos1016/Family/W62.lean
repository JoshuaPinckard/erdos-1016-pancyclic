theorem isPancyclic_GF62 : IsPancyclic GF62 :=
  isPancyclic_of_candidates GF62 adjF62 adjF62_spec cyclesF62F candidatesF62

def csF62 : Finset (Sym2 (Fin 62)) := {s(0,2), s(0,55), s(1,13), s(3,56), s(4,31), s(54,57)}
