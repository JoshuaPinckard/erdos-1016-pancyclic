set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF57_iff (a b : Fin 57) :
    (adjF57 a b = true ∨ adjF57 b a = true) ↔
      ((b.val = (a.val + 1) % 57 ∨ a.val = (b.val + 1) % 57) ∨ s(a, b) ∈ csF57) := by
  revert a b
  decide

theorem GF57_eq : baseCycle 57 ⊔ SimpleGraph.fromEdgeSet (↑csF57 : Set (Sym2 (Fin 57))) = GF57 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF57, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF57_iff a b
  unfold adjF57 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF57_disjoint : ∀ e ∈ csF57, e ∉ (baseCycle 57).edgeSet := by
  intro e he
  simp only [csF57, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

