set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF53_iff (a b : Fin 53) :
    (adjF53 a b = true ∨ adjF53 b a = true) ↔
      ((b.val = (a.val + 1) % 53 ∨ a.val = (b.val + 1) % 53) ∨ s(a, b) ∈ csF53) := by
  revert a b
  decide

theorem GF53_eq : baseCycle 53 ⊔ SimpleGraph.fromEdgeSet (↑csF53 : Set (Sym2 (Fin 53))) = GF53 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF53, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF53_iff a b
  unfold adjF53 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF53_disjoint : ∀ e ∈ csF53, e ∉ (baseCycle 53).edgeSet := by
  intro e he
  simp only [csF53, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

