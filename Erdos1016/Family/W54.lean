theorem adjF54_iff (a b : Fin 54) :
    (adjF54 a b = true ∨ adjF54 b a = true) ↔
      ((b.val = (a.val + 1) % 54 ∨ a.val = (b.val + 1) % 54) ∨ s(a, b) ∈ csF54) := by
  revert a b
  decide

theorem GF54_eq : baseCycle 54 ⊔ SimpleGraph.fromEdgeSet (↑csF54 : Set (Sym2 (Fin 54))) = GF54 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF54, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF54_iff a b
  unfold adjF54 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF54_disjoint : ∀ e ∈ csF54, e ∉ (baseCycle 54).edgeSet := by
  intro e he
  simp only [csF54, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

