def csF60 : Finset (Sym2 (Fin 60)) := {s(0,2), s(0,53), s(1,13), s(3,54), s(4,31), s(52,55)}
set_option maxHeartbeats 0 in
theorem csF60_card : csF60.card = 6 := by decide

-- `decide` over all pairs of `Fin 60`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF60_iff (a b : Fin 60) :
    (adjF60 a b = true ∨ adjF60 b a = true) ↔
      ((b.val = (a.val + 1) % 60 ∨ a.val = (b.val + 1) % 60) ∨ s(a, b) ∈ csF60) := by
  revert a b
  decide

theorem GF60_eq : baseCycle 60 ⊔ SimpleGraph.fromEdgeSet (↑csF60 : Set (Sym2 (Fin 60))) = GF60 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF60, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF60_iff a b
  unfold adjF60 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF60_disjoint : ∀ e ∈ csF60, e ∉ (baseCycle 60).edgeSet := by
  intro e he
  simp only [csF60, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

/-- `h(60) ≤ 6`, by the family member at n = 60. -/
theorem pancyclicWithChords_F60 : PancyclicWithChords 60 6 :=
  ⟨csF60, csF60_card, csF60_disjoint, by rw [GF60_eq]; exact isPancyclic_GF60⟩

