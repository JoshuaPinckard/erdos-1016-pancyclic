theorem csF51_card : csF51.card = 6 := by decide

-- `decide` over all pairs of `Fin 51`: the n = 56 template ran just inside the default
-- heartbeat and recursion limits, n >= 60 does not (W60/W64/W66 failed at these lines on
-- 2026-09-19 22:58), so both limits are lifted for this kernel computation.
set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem adjF51_iff (a b : Fin 51) :
    (adjF51 a b = true ∨ adjF51 b a = true) ↔
      ((b.val = (a.val + 1) % 51 ∨ a.val = (b.val + 1) % 51) ∨ s(a, b) ∈ csF51) := by
  revert a b
  decide

theorem GF51_eq : baseCycle 51 ⊔ SimpleGraph.fromEdgeSet (↑csF51 : Set (Sym2 (Fin 51))) = GF51 := by
  ext a b
  simp only [SimpleGraph.sup_adj, baseCycle, GF51, SimpleGraph.fromRel_adj,
    SimpleGraph.fromEdgeSet_adj, Finset.mem_coe]
  have h := adjF51_iff a b
  unfold adjF51 at h
  constructor
  · rintro (⟨hne, hc⟩ | ⟨hm, hne⟩)
    · exact ⟨hne, h.2 (Or.inl hc)⟩
    · exact ⟨hne, h.2 (Or.inr hm)⟩
  · rintro ⟨hne, hadj⟩
    rcases h.1 hadj with hc | hm
    · exact Or.inl ⟨hne, hc⟩
    · exact Or.inr ⟨hm, hne⟩

theorem csF51_disjoint : ∀ e ∈ csF51, e ∉ (baseCycle 51).edgeSet := by
  intro e he
  simp only [csF51, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [SimpleGraph.mem_edgeSet, baseCycle, SimpleGraph.fromRel_adj]

