open SimpleGraph
namespace Erdos1016

def chords56 : List (Nat × Nat) := [(0,2),(0,53),(1,39),(20,39),(39,48),(48,53)]
def adj56 (a b : Fin 56) : Bool := adjB 56 chords56 a.val b.val
def G56 : SimpleGraph (Fin 56) :=
  SimpleGraph.fromRel (fun u v => adjB 56 chords56 u.val v.val = true)
theorem adj56_irrefl : ∀ a : Fin 56, adj56 a a = false := by decide
theorem adj56_spec (a b : Fin 56) (h : adj56 a b = true) : G56.Adj a b := by
  unfold G56
  rw [SimpleGraph.fromRel_adj]
  refine ⟨fun hab => ?_, Or.inl h⟩
  subst hab
  rw [adj56_irrefl] at h
  exact Bool.false_ne_true h

