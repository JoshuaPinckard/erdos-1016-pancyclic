def cycles56F : List (List (Fin 56)) :=
  cycles56.map (List.map (fun v : ℕ => (⟨v % 56, Nat.mod_lt v (by decide)⟩ : Fin 56)))

set_option maxRecDepth 100000 in
theorem candidates56 : (List.range' 3 (56 - 2)).all (fun ℓ => cycles56F.any (fun l =>
    (l.length == ℓ) && decide l.Nodup && chainB adj56 l && closesB adj56 l)) = true := by decide

theorem isPancyclic_G56 : IsPancyclic G56 :=
  isPancyclic_of_candidates G56 adj56 adj56_spec cycles56F candidates56

