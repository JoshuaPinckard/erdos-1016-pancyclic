#!/bin/bash
# erdos-thermal-guard -- keep the Erdos1016 laptop jobs from cooking the box.
#
# 2026-09-18: the laptop shut itself off twice in one day while
# erdos-descent (4 cores) and erdos-laptop-chain (GPU at 100%) ran together;
# the GPU had sat at 86-87 C for over 24 h.  erdos-fan-pin already runs the
# fans at their maximum and measured no headroom from airflow, so the only
# lever left is power: cap the GPU clock, and freeze both units whenever the
# sensors approach the shutdown region, thawing once they have come back down.
#
# Freeze/thaw is SIGSTOP/SIGCONT on the whole unit cgroup.  Both jobs are safe
# to freeze: hunt.py has no wall-clock timeouts (only a node budget), the GPU
# runner's lock heartbeat merely pauses and nothing else launches a runner
# while the chain unit is stopped, and both resume from their ledgers if the
# box does go down anyway.  A frozen job loses time; a thermal shutdown loses
# the shapes in flight and, eventually, the laptop.
#
# THE NUMBER THAT MATTERS: an earlier agent installed a thermal backstop on
# this laptop (thermal-backstop.service) that POWERS IT OFF when any thermal
# zone with a `critical` trip reaches it.  On this box those are the ASUS
# chassis zones SEN1/SEN2/SEN3 at 80 C (plus acpitz at 105 C); both 2026-09-18
# shutdowns were "SEN2 reached 80C".  The CPU package and the GPU die are NOT
# what it watches: under the CPU-only descent the package sits at 75-77 C while
# SEN1-3 read 50-53 C.  So the primary signal here is the MARGIN to the
# nearest critical trip, read from the very same zones the backstop reads, and
# the guard freezes while that margin is small.  The GPU and CPU package
# thresholds remain as silicon guards (the GPU's own throttle target is 87 C,
# the CPU throttles itself at 100 C) but they sit at silicon-sensible values,
# not at values chosen for the backstop.  The CPU package spikes to 85-86 C
# for a single sample several times an hour under turbo and is back at 66-70 C
# fifteen seconds later; a limit at 85 froze both jobs on every such spike.
# Hysteresis: freeze when margin <= FREEZE_MARGIN, gpu >= FREEZE_GPU or cpu >=
# FREEZE_CPU; thaw only when margin >= THAW_MARGIN AND gpu <= THAW_GPU AND
# cpu <= THAW_CPU.  Sampling every POLL seconds; the backstop needs two
# consecutive 5 s samples at critical, so a 15 s poll with an 8 C margin on a
# chassis sensor that moves about 1 C / 10 s is comfortably inside it.
set -u
UNITS="${GUARD_UNITS:-erdos-descent.service erdos-laptop-chain.service}"
FREEZE_MARGIN="${FREEZE_MARGIN:-8}"
THAW_MARGIN="${THAW_MARGIN:-14}"
FREEZE_GPU="${FREEZE_GPU:-75}"
FREEZE_CPU="${FREEZE_CPU:-90}"
THAW_GPU="${THAW_GPU:-66}"
THAW_CPU="${THAW_CPU:-80}"
POLL="${POLL:-15}"
# GPU core clock ceiling in MHz.  The n=70 b=10 run settled at 2100 MHz / 87 C
# and tripped the backstop.  Measured 2026-09-18 with both jobs running: at
# 1200 MHz the GPU sits at 65 C / 32 W and SEN2 at 62-63 C (17-18 C of margin);
# at 1400 MHz it is 67-68 C / 39 W and SEN2 64-65 C (15-16 C of margin), with a
# GPU unit taking 65 s instead of 75 s.  1400 is the default; 1500 would put
# the margin inside the thaw band.  Raise only with the guard log showing
# headroom.
GPU_MAX_CLOCK="${GPU_MAX_CLOCK:-1400}"
LOG="${GUARD_LOG:-/home/j/erdos-thermal-guard.log}"

log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }

# Both sensor readers print a whole number of degrees, or NOTHING when they
# could not read anything at all.  An empty reading is deliberately not folded
# into 0: 0 C compares as "cool" against every threshold, so a guard that
# treated an unreadable sensor as 0 would run the jobs blind at full tilt,
# which is the exact failure it exists to prevent.  See the blind branch below.
SANE_MAX="${SANE_MAX:-125}"
# Overridable so the test harness can point the reader at a fixture tree; the
# default is the real sysfs.  Deliberately unquoted where it is used: it is a
# list of globs.
HWMON_GLOB="${HWMON_GLOB:-/sys/class/hwmon/hwmon*/temp*_input /sys/class/thermal/thermal_zone*/temp}"
ZONE_GLOB="${ZONE_GLOB:-/sys/class/thermal/thermal_zone*}"

gpu_temp() {
  local v
  v=$(timeout 10 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc '0-9')
  [ -n "$v" ] || return 0
  # A card reading above SANE_MAX is a broken sensor, not a reading.
  [ "$v" -le "$SANE_MAX" ] || return 0
  echo "$v"
}

cpu_temp() {
  # Hottest of: k10temp/coretemp package sensors, then any thermal zone.  All in
  # millidegrees.  Readings above SANE_MAX are dropped: this box is known to
  # produce garbage from at least one hwmon channel when a fan is pinned, and a
  # single bogus 3283100 would otherwise pin the guard frozen forever.
  local best="" v d
  for f in $HWMON_GLOB; do
    [ -r "$f" ] || continue
    v=$(cat "$f" 2>/dev/null) || continue
    case "$v" in ''|*[!0-9]*) continue;; esac
    d=$((v / 1000))
    [ "$d" -le "$SANE_MAX" ] || continue
    if [ -z "$best" ] || [ "$d" -gt "$best" ]; then best="$d"; fi
  done
  [ -n "$best" ] && echo "$best"
}

crit_margin() {
  # Smallest (critical trip - current temperature), in whole degrees, over the
  # zones that carry a critical trip -- exactly the set thermal-backstop
  # discovers, read the way it reads them.  Prints nothing when no such zone
  # is readable this round.  A garbage temperature (above SANE_MAX) is dropped
  # just like in cpu_temp; a garbage trip is skipped with its zone.
  local best="" z t v c d m
  for z in $ZONE_GLOB; do
    [ -d "$z" ] || continue
    c=""
    for t in "$z"/trip_point_*_type; do
      [ -r "$t" ] || continue
      [ "$(cat "$t" 2>/dev/null)" = critical ] || continue
      c=$(cat "${t%_type}_temp" 2>/dev/null)
      break
    done
    case "$c" in ''|*[!0-9]*) continue;; esac
    v=$(cat "$z/temp" 2>/dev/null) || continue
    case "$v" in ''|*[!0-9]*) continue;; esac
    d=$((v / 1000))
    [ "$d" -le "$SANE_MAX" ] || continue
    m=$((c / 1000 - d))
    if [ -z "$best" ] || [ "$m" -lt "$best" ]; then best="$m"; fi
  done
  [ -n "$best" ] && echo "$best"
}

apply_clock_cap() {
  if timeout 10 nvidia-smi -lgc 0,"$GPU_MAX_CLOCK" >/dev/null 2>&1; then
    log "gpu clock ceiling set to ${GPU_MAX_CLOCK} MHz"
  else
    log "WARN could not set gpu clock ceiling (nvidia-smi -lgc failed); freeze/thaw only"
  fi
}
release_clock_cap() { timeout 10 nvidia-smi -rgc >/dev/null 2>&1 && log "gpu clock ceiling released"; }

frozen=0
freeze() {
  systemctl kill --signal=SIGSTOP $UNITS 2>/dev/null
  frozen=1
  log "FREEZE margin=${3}C gpu=${1}C cpu=${2}C (limits margin<=${FREEZE_MARGIN} gpu>=${FREEZE_GPU} cpu>=${FREEZE_CPU})"
}
thaw() {
  systemctl kill --signal=SIGCONT $UNITS 2>/dev/null
  frozen=0
  log "THAW margin=${3}C gpu=${1}C cpu=${2}C"
}
on_exit() {
  # Never leave the jobs frozen if the guard itself goes away.
  if [ "$frozen" = 1 ]; then g=$(gpu_temp); c=$(cpu_temp); m=$(crit_margin); thaw "${g:-?}" "${c:-?}" "${m:-?}"; fi
  release_clock_cap
  log "guard exiting"
  exit 0
}
trap on_exit TERM INT

log "guard start units=[$UNITS] freeze margin<=${FREEZE_MARGIN} gpu>=${FREEZE_GPU} cpu>=${FREEZE_CPU} thaw margin>=${THAW_MARGIN} gpu<=${THAW_GPU} cpu<=${THAW_CPU} poll=${POLL}s"
list_crit_zones() {
  # "SEN2@80C SEN3@80C ..." for the start-of-guard log line; garbage trips print raw.
  local z t c
  for z in $ZONE_GLOB; do
    for t in "$z"/trip_point_*_type; do
      [ -r "$t" ] || continue
      [ "$(cat "$t" 2>/dev/null)" = critical ] || continue
      c=$(cat "${t%_type}_temp" 2>/dev/null)
      case "$c" in ''|*[!0-9]*) printf '%s@%s(bad) ' "$(cat "$z/type" 2>/dev/null)" "$c";;
                   *) printf '%s@%sC ' "$(cat "$z/type" 2>/dev/null)" "$((c / 1000))";; esac
      break
    done
  done
}
log "critical zones: $(list_crit_zones)"
apply_clock_cap
n=0
blind_logged=0
while true; do
  g=$(gpu_temp); c=$(cpu_temp); m=$(crit_margin)

  # blind: not one usable sensor this round.  Fail closed -- freeze, and stay
  # frozen until a real reading comes back and says it is cool.
  if [ -z "$g" ] && [ -z "$c" ] && [ -z "$m" ]; then
    if [ "$frozen" = 0 ]; then
      freeze "?" "?" "?"
      log "WARN no readable temperature sensor; frozen until one returns"
    elif [ "$blind_logged" = 0 ]; then
      log "WARN still no readable temperature sensor; staying frozen"
    fi
    blind_logged=1
  else
    blind_logged=0
    hot=0
    [ -n "$m" ] && [ "$m" -le "$FREEZE_MARGIN" ] && hot=1
    [ -n "$g" ] && [ "$g" -ge "$FREEZE_GPU" ] && hot=1
    [ -n "$c" ] && [ "$c" -ge "$FREEZE_CPU" ] && hot=1
    # Cool means every sensor we CAN read is at or under its thaw point.  A
    # sensor that is missing this round cannot vote for thawing.
    cool=1
    [ -n "$m" ] && [ "$m" -lt "$THAW_MARGIN" ] && cool=0
    [ -n "$g" ] && [ "$g" -gt "$THAW_GPU" ] && cool=0
    [ -n "$c" ] && [ "$c" -gt "$THAW_CPU" ] && cool=0
    if [ "$frozen" = 0 ]; then
      [ "$hot" = 1 ] && freeze "${g:-?}" "${c:-?}" "${m:-?}"
    else
      [ "$cool" = 1 ] && thaw "${g:-?}" "${c:-?}" "${m:-?}"
    fi
  fi
  # One line every 5 minutes so the temperature history is on disk after a crash.
  n=$((n + 1))
  if [ $((n % (300 / POLL))) -eq 0 ]; then log "sample margin=${m:-?}C gpu=${g:-?}C cpu=${c:-?}C frozen=${frozen}"; fi
  sleep "$POLL"
done
