[Unit]
Description=Erdos1016 laptop range-mode descent (k=6, levels 93..88)
After=multi-user.target

[Service]
Type=simple
User=j
Group=j
WorkingDirectory=/home/j/erdos-shapecsp
# Resumable: hunt.py keeps a per-shape .done file per level, so a restart
# re-runs only the undecided shapes of the level it stopped in.
#
# Worker count is deliberately matched to CPUQuota.  Running more workers than
# the quota affords does not add throughput; it just makes the whole cgroup
# freeze together at the end of each accounting period, which is exactly the
# latency other agents on this box feel.
ExecStart=/home/j/erdos-shapecsp/.venv/bin/python -u /home/j/erdos-shapecsp/descend.py 6 93 88 4 8000000000
# Correction 2026-09-16: the earlier 1300% grant was starving other
# agents on this laptop.  Cut to 4 of 16 cores.
# Measured immediately after the cut: idle went from 6% to 57%.
CPUQuota=400%
Nice=19
IOSchedulingClass=idle
# This is a FINITE pipeline, not a daemon: levels 93..88 then done.  With
# Restart=always it would relaunch forever on success, and at RestartSec=30 the
# default start-rate limiter can never trip.  on-failure plus RemainAfterExit
# lets a completed descent stay visibly "active (exited)" instead.
Restart=on-failure
RestartSec=30
RemainAfterExit=yes
StandardOutput=append:/home/j/erdos-shapecsp/descend.log
StandardError=append:/home/j/erdos-shapecsp/descend.log

[Install]
WantedBy=multi-user.target
